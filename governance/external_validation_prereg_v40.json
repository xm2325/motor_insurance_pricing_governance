{
  "schema_version": "0.40",
  "registered_before_row_level_access": true,
  "registration_purpose": "Freeze a second independent external motor-insurance model-family replication protocol before Belgian row-level outcomes are downloaded or inspected in this repository.",
  "source": {
    "dataset": "beMTPL97",
    "package": "CASdatasets",
