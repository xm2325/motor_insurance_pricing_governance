    "upstream_commit": "227fb56b8734bdb7c0327a41180e01d2ddaeaf26",
    "upstream_path": "data/beMTPL97.rda",
    "package_license": "GPL (>= 2)",
    "portfolio_context": "Belgian motor third-party liability policies observed in 1997; insurer is anonymised/unknown in the public documentation.",
    "references": [
      "Lemaire (1995), Bonus-malus systems in automobile insurance",
      "Denuit and Lang (2004), Non-life rate-making with Bayesian GAMs",
      "Denuit et al. (2007), Actuarial modelling of claim counts",
      "Klein et al. (2014), Nonlife ratemaking and risk management with Bayesian generalized additive models",
      "Henckaerts et al. (2018), A data driven binning strategy for the construction of insurance tariff classes"
    ],
    "known_from_public_documentation_before_row_level_access": {
      "rows": 163212,
      "unique_policyholders": 163212,
      "columns": 18,
      "column_names": [
        "id",
        "expo",
        "claim",
        "nclaims",
        "amount",
        "average",
        "coverage",
        "ageph",
        "sex",
        "bm",
        "power",
        "agec",
        "fuel",
        "use",
        "fleet",
        "postcode",
        "long",
        "lat"
      ],
      "exposure_semantics": "fraction of a year during which the policyholder was exposed to risk",
      "claim_count_field": "nclaims",
      "aggregate_claim_amount_field": "amount"
    }
  },
  "independence_statement": {
    "not_previously_used_by_project": true,
    "not_a_transport_test_of_spanish_or_australian_fitted_parameters": true,
    "not_a_reuse_of_the_consumed_australian_locked_test": true,
    "evidence_class": "SECOND_EXTERNAL_PORTFOLIO_MODEL_FAMILY_REPLICATION",
    "limitation": "This is an independent replication of a GLM-vs-XGBoost model-family question on an older Belgian MTPL portfolio with different covariates. It is not direct validation of Spanish or Australian fitted parameters and is not evidence of transfer to FIRST CENTRAL or the current UK motor market."
  },
  "data_contract": {
    "required_rows": 163212,
    "required_columns": [
      "id",
      "expo",
      "claim",
      "nclaims",
      "amount",
      "average",
      "coverage",
      "ageph",
      "sex",
      "bm",
      "power",
      "agec",
      "fuel",
      "use",
      "fleet",
      "postcode",
      "long",
      "lat"
    ],
    "required_nonmissing_for_model": [
      "id",
      "expo",
      "nclaims",
      "amount",
      "coverage",
      "ageph",
      "bm",
      "power",
      "agec",
      "fuel",
      "use",
      "fleet"
    ],
    "fail_on_duplicate_id": true,
    "fail_on_nonpositive_exposure": true,
    "fail_on_exposure_above_one": true,
    "fail_on_negative_claim_count": true,
    "fail_on_noninteger_claim_count": true,
    "fail_on_negative_claim_amount": true,
    "fail_on_nonfinite_numeric_model_input": true,
    "no_post_download_row_filtering": true,
    "no_outcome_winsorisation_or_clipping": true
  },
  "features": {
    "numeric": [
      "ageph",
      "bm",
      "power",
      "agec"
    ],
    "categorical": [
      "coverage",
      "fuel",
      "use",
      "fleet"
    ],
    "excluded_from_predictors": [
      "id",
      "expo",
      "claim",
      "nclaims",
      "amount",
      "average",
      "sex",
      "postcode",
      "long",
      "lat"
    ],
    "identifier_rule": "id is an identifier only and must never enter preprocessing, fitting, calibration, ranking or scoring features.",
    "outcome_leakage_rule": "claim and average are outcome-derived fields and must never enter preprocessing, fitting, calibration, ranking or scoring features.",
    "sex_policy": "sex is deliberately excluded from the primary replication feature set as a project design choice; this is not presented as a legal conclusion for Belgium or the UK.",
    "spatial_policy": "postcode, long and lat are deliberately excluded to avoid geography-specific feature engineering and spatial proxy effects in this cross-portfolio model-family replication; this is a modelling-scope choice, not a legal conclusion.",
    "preprocessing": {
      "fit_on_training_only": true,
      "numeric_transform": "StandardScaler",
      "categorical_transform": "OneHotEncoder(handle_unknown='ignore', sparse_output=False)",
      "category_pooling_or_target_encoding_allowed": false
    }
  },
  "split": {
    "method": "fixed random permutation of source row indices without outcome stratification",
    "seed": 20260825,
    "train_fraction": 0.6,
    "calibration_fraction": 0.2,
    "locked_test_fraction": 0.2,
    "test_used_for_hyperparameter_selection": false,
    "calibration_used_for_hyperparameter_selection": false,
    "resplitting_after_outcome_inspection_allowed": false
  },
  "targets": {
    "primary": {
      "name": "frequency",
      "observed_count": "nclaims",
      "rate": "nclaims / expo",
      "weight": "expo",
      "metric": "exposure-weighted mean Poisson deviance"
    },
    "secondary_confirmatory": {
      "name": "pure_premium",
      "observed_amount": "amount",
      "rate": "amount / expo",
      "weight": "expo",
      "metric": "exposure-weighted mean Tweedie deviance with power 1.5"
    }
  },
  "runtime_reproducibility": {
    "python_version": "3.12",
    "numpy_version": "2.5.2",
    "scipy_version": "1.18.0",
    "scikit_learn_version": "1.9.0",
    "xgboost_version": "3.4.1",
    "pyreadr_version": "0.5.3",
    "thread_environment": {
      "OMP_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1"
    },
    "minimum_independent_actions_executions_for_positive_external_support": 2,
    "positive_external_support_requires_matching_registered_decisions": true,
    "positive_external_support_requires_registered_point_metric_reproducibility": true,
    "point_metric_relative_tolerance": 1e-8,
    "point_metric_absolute_tolerance": 1e-10,
    "if_decision_matches_but_point_metric_tolerance_fails": "METRIC_NUMERICAL_REPRODUCIBILITY_REVIEW",
    "if_any_positive_gate_is_not_reproduced": "NO_EXTERNAL_REPLICATION_SUPPORT"
  },
  "models": {
    "frequency_glm": {
      "estimator": "sklearn.linear_model.PoissonRegressor",
      "alpha": 1e-8,
      "solver": "newton-cholesky",
      "tol": 1e-10,
      "max_iter": 500,
      "fit_intercept": true,
      "convergence_required": true,
      "fallback_solver_allowed": false
    },
    "frequency_xgb": {
      "estimator": "xgboost.XGBRegressor",
      "objective": "count:poisson",
      "n_estimators": 400,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 20,
      "reg_lambda": 5.0,
      "random_state": 20260825,
      "n_jobs": 1
    },
    "pure_premium_glm": {
      "estimator": "sklearn.linear_model.TweedieRegressor",
      "power": 1.5,
      "alpha": 1e-6,
      "link": "log",
      "solver": "newton-cholesky",
      "tol": 1e-10,
      "max_iter": 500,
      "fit_intercept": true,
      "convergence_required": true,
      "fallback_solver_allowed": false
    },
    "pure_premium_xgb": {
      "estimator": "xgboost.XGBRegressor",
      "objective": "reg:tweedie",
      "tweedie_variance_power": 1.5,
      "n_estimators": 400,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 20,
      "reg_lambda": 5.0,
      "random_state": 20260825,
      "n_jobs": 1
    },
    "hyperparameter_search_allowed": false,
    "early_stopping_allowed": false,
    "post_result_solver_change_allowed": false
  },
  "calibration": {
    "method": "single multiplicative scale estimated on calibration split only",
    "frequency_scale": "sum(nclaims) / sum(predicted_frequency_rate * expo)",
    "pure_premium_scale": "sum(amount) / sum(predicted_pure_premium_rate * expo)",
    "scale_guardrails": [
      0.5,
      2.0
    ],
    "scale_clipping_allowed": false,
    "if_scale_outside_guardrails": "REPORT_INVALID_EXTERNAL_CANDIDATE_AND_RETAIN_HOLD"
  },
  "locked_test_metrics": {
    "primary": [
      "poisson_deviance",
      "aggregate_calibration_ratio_pred_over_actual",
      "aggregate_abs_log_calibration_error",
      "top_10_percent_exposure_claim_capture"
    ],
    "secondary": [
      "tweedie_deviance_p1_5",
      "aggregate_calibration_ratio_pred_over_actual",
      "aggregate_abs_log_calibration_error",
      "top_10_percent_exposure_loss_capture"
    ]
  },
  "paired_bootstrap": {
    "draws": 500,
    "seed": 20260826,
    "resampling_unit": "locked-test policy row",
    "paired_across_models": true,
    "interval": "95% percentile interval",
    "primary_statistic": "1 - XGB Poisson deviance / GLM Poisson deviance",
    "secondary_statistic": "1 - XGB Tweedie deviance / GLM Tweedie deviance"
  },
  "registered_external_replication_gate": {
    "minimum_relative_deviance_improvement": 0.005,
    "bootstrap_relative_improvement_ci_lower_bound_must_exceed": 0.0,
    "maximum_additional_abs_log_aggregate_calibration_error": 0.01,
    "frequency_pass_label": "SECOND_EXTERNAL_REPLICATION_SUPPORTS_XGB_FREQUENCY_FOR_FURTHER_VALIDATION",
    "frequency_fail_label": "NO_SECOND_EXTERNAL_FREQUENCY_REPLICATION_SUPPORT",
    "pure_premium_pass_label": "SECOND_EXTERNAL_REPLICATION_SUPPORTS_XGB_PURE_PREMIUM_FOR_FURTHER_VALIDATION",
    "pure_premium_fail_label": "NO_SECOND_EXTERNAL_PURE_PREMIUM_REPLICATION_SUPPORT"
  },
  "decision_boundary": {
    "model_family_decision_after_v40": "HOLD",
    "serving_status_after_v40": "HOLD_SHADOW_ONLY",
    "external_replication_can_directly_authorise_model_promotion": false,
    "external_replication_can_directly_authorise_customer_pricing": false,
    "no_rule_split_feature_model_solver_metric_gate_or_reproducibility_changes_after_test_results": true,
    "execution_allowed_only_after_preregistration_is_on_main": true,
    "interpretation": "Even a reproduced positive Belgian replication would support further validation only. It cannot override the Spanish or Australian evidence, authorise production promotion, or establish current UK/FIRST CENTRAL pricing validity."
  }
}
