{
  "schema_version": "0.36",
  "registered_before_row_level_access": true,
  "registration_purpose": "Freeze an external motor-insurance model-family replication protocol before row-level outcomes are downloaded or inspected in this repository.",
  "source": {
    "dataset": "ausprivauto0405",
    "package": "CASdatasets",
    "package_version_documented": "1.2-1",
    "package_doi": "10.57745/P0KHAG",
    "upstream_repository": "dutangc/CASdatasets",
    "upstream_commit": "227fb56b8734bdb7c0327a41180e01d2ddaeaf26",
    "upstream_path": "data/ausprivauto0405.rda",
    "package_license": "GPL (>= 2)",
    "reference": "De Jong and Heller (2008), Generalized Linear Models for Insurance Data",
    "reference_doi": "10.1017/CBO9780511755408",
    "portfolio_context": "Australian private motor policies written in 2004 or 2005",
    "known_from_public_documentation_before_row_level_access": {
      "rows": 67856,
      "columns": 9,
      "policies_with_at_least_one_claim": 4624,
      "column_names": [
        "Exposure",
        "VehValue",
        "VehAge",
        "VehBody",
        "Gender",
        "DrivAge",
        "ClaimOcc",
        "ClaimNb",
        "ClaimAmount"
      ]
    }
  },
  "independence_statement": {
    "not_previously_used_by_project": true,
    "not_a_transport_test_of_the_spanish_fitted_parameters": true,
    "evidence_class": "EXTERNAL_PORTFOLIO_MODEL_FAMILY_REPLICATION",
    "limitation": "Different features and portfolio context mean this is an independent replication of the GLM-vs-XGBoost model-family question, not direct validation of the Spanish fitted model and not evidence of transfer to FIRST CENTRAL or the UK market."
  },
  "data_contract": {
    "required_rows": 67856,
    "required_columns": [
      "Exposure",
      "VehValue",
      "VehAge",
      "VehBody",
      "Gender",
      "DrivAge",
      "ClaimOcc",
      "ClaimNb",
      "ClaimAmount"
    ],
    "fail_on_missing_required_value": true,
    "fail_on_nonpositive_exposure": true,
    "fail_on_negative_claim_count": true,
    "fail_on_noninteger_claim_count": true,
    "fail_on_negative_claim_amount": true,
    "no_post_download_row_filtering": true
  },
  "features": {
    "numeric": ["VehValue"],
    "categorical": ["VehAge", "VehBody", "DrivAge"],
    "excluded_from_predictors": [
      "Exposure",
      "Gender",
      "ClaimOcc",
      "ClaimNb",
      "ClaimAmount"
    ],
    "gender_policy": "Gender is deliberately excluded from the primary replication feature set; this is a project design choice and not presented as a legal conclusion about the Australian source portfolio.",
    "claimocc_leakage_rule": "ClaimOcc is outcome-derived and must never enter preprocessing, fitting, calibration, ranking or scoring features.",
    "categorical_unknown_policy": "One-hot encoding fitted on training only with handle_unknown=ignore."
  },
  "split": {
    "method": "fixed random permutation of source row indices without outcome stratification",
    "seed": 20260823,
    "train_fraction": 0.60,
    "calibration_fraction": 0.20,
    "locked_test_fraction": 0.20,
    "test_used_for_hyperparameter_selection": false,
    "calibration_used_for_hyperparameter_selection": false,
    "resplitting_after_outcome_inspection_allowed": false
  },
  "targets": {
    "primary": {
      "name": "frequency",
      "observed_count": "ClaimNb",
      "rate": "ClaimNb / Exposure",
      "weight": "Exposure",
      "metric": "exposure-weighted mean Poisson deviance"
    },
    "secondary_confirmatory": {
      "name": "pure_premium",
      "observed_amount": "ClaimAmount",
      "rate": "ClaimAmount / Exposure",
      "weight": "Exposure",
      "metric": "exposure-weighted mean Tweedie deviance with power 1.5"
    }
  },
  "models": {
    "frequency_glm": {
      "estimator": "sklearn.linear_model.PoissonRegressor",
      "alpha": 1e-08,
      "max_iter": 2000,
      "fit_intercept": true
    },
    "frequency_xgb": {
      "estimator": "xgboost.XGBRegressor",
      "objective": "count:poisson",
      "n_estimators": 400,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 20,
      "reg_lambda": 5.0,
      "random_state": 20260823,
      "n_jobs": 2
    },
    "pure_premium_glm": {
      "estimator": "sklearn.linear_model.TweedieRegressor",
      "power": 1.5,
      "alpha": 1e-06,
      "link": "log",
      "max_iter": 3000,
      "fit_intercept": true
    },
    "pure_premium_xgb": {
      "estimator": "xgboost.XGBRegressor",
      "objective": "reg:tweedie",
      "tweedie_variance_power": 1.5,
      "n_estimators": 400,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 20,
      "reg_lambda": 5.0,
      "random_state": 20260823,
      "n_jobs": 2
    },
    "hyperparameter_search_allowed": false,
    "early_stopping_allowed": false
  },
  "calibration": {
    "method": "single multiplicative scale estimated on calibration split only",
    "frequency_scale": "sum(ClaimNb) / sum(predicted_frequency_rate * Exposure)",
    "pure_premium_scale": "sum(ClaimAmount) / sum(predicted_pure_premium_rate * Exposure)",
    "scale_guardrails": [0.5, 2.0],
    "scale_clipping_allowed": false,
    "if_scale_outside_guardrails": "REPORT_INVALID_EXTERNAL_CANDIDATE_AND_RETAIN_HOLD"
  },
  "locked_test_metrics": {
    "primary": [
      "poisson_deviance",
      "aggregate_calibration_ratio_pred_over_actual",
      "aggregate_abs_log_calibration_error",
      "top_10_percent_exposure_claim_capture"
    ],
    "secondary": [
      "tweedie_deviance_p1_5",
      "aggregate_calibration_ratio_pred_over_actual",
      "aggregate_abs_log_calibration_error",
      "top_10_percent_exposure_loss_capture"
    ]
  },
  "paired_bootstrap": {
    "draws": 500,
    "seed": 20260824,
    "resampling_unit": "locked-test policy row",
    "paired_across_models": true,
    "interval": "95% percentile interval",
    "primary_statistic": "1 - XGB Poisson deviance / GLM Poisson deviance",
    "secondary_statistic": "1 - XGB Tweedie deviance / GLM Tweedie deviance"
  },
  "registered_external_replication_gate": {
    "minimum_relative_deviance_improvement": 0.005,
    "bootstrap_relative_improvement_ci_lower_bound_must_exceed": 0.0,
    "maximum_additional_abs_log_aggregate_calibration_error": 0.01,
    "frequency_pass_label": "EXTERNAL_REPLICATION_SUPPORTS_XGB_FREQUENCY_FOR_FURTHER_VALIDATION",
    "frequency_fail_label": "NO_EXTERNAL_FREQUENCY_REPLICATION_SUPPORT",
    "pure_premium_pass_label": "EXTERNAL_REPLICATION_SUPPORTS_XGB_PURE_PREMIUM_FOR_FURTHER_VALIDATION",
    "pure_premium_fail_label": "NO_EXTERNAL_PURE_PREMIUM_REPLICATION_SUPPORT"
  },
  "decision_boundary": {
    "model_family_decision_after_v36": "HOLD",
    "serving_status_after_v36": "HOLD_SHADOW_ONLY",
    "external_replication_can_directly_authorise_model_promotion": false,
    "external_replication_can_directly_authorise_customer_pricing": false,
    "no_rule_split_or_hyperparameter_changes_after_test_results": true,
    "interpretation": "Even a positive Australian replication is evidence for further independent validation, not a production or UK pricing approval."
  }
}
